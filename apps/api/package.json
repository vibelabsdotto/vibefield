{
  "name": "@vibefield/api",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --no-error-on-unmatched-pattern",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@vibefield/contracts": "*",
    "@vibefield/prompt": "*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7",
    "sharp": "0.35.5",
    "multer": "2.4.0",
    "archiver": "8.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/multer": "2.3.0",
    "@types/express": "5.0.6",
    "@types/archiver": "8.0.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
