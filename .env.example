# Local data stays outside the source tree.
# VIBEFIELD_HOME=/absolute/path/to/vibefield-data
VIBEFIELD_API_PORT=4317
VIBEFIELD_WEB_PORT=4318

# Experimental Codex images. Explicit opt-in, no automatic login or token refresh.
# Run `codex login` first, then point at YOUR file-backed Codex login.
# Keyring-only login is not read by this adapter.
VIBEFIELD_EXPERIMENTAL_CODEX_IMAGES=0
# VIBEFIELD_CODEX_AUTH_FILE=/absolute/path/to/.codex/auth.json
# Alternatively supply VIBEFIELD_CODEX_ACCESS_TOKEN and optional
# VIBEFIELD_CODEX_ACCOUNT_ID through a trusted backend process environment.

# OpenRouter text and video use your API account. Never commit this key.
# OPENROUTER_API_KEY=
VIBEFIELD_ALLOW_VIDEO=0
VIBEFIELD_VIDEO_SUBMISSION_CAP=5
